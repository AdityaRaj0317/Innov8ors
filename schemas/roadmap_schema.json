{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectRoadmap",
  "type": "object",
  "required": ["project_summary", "milestones"],
  "properties": {
    "project_summary": {
      "type": "string",
      "description": "A 2-sentence technical overview of the goal."
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "technical_checklist", "estimated_days", "payout_percentage"],
        "properties": {
          "title": {
            "type": "string"
          },
          "technical_checklist": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 3,
            "maxItems": 5
          },
          "estimated_days": {
            "type": ["integer", "string"]
          },
          "payout_percentage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    }
  }
}
